# Copy this file to .env and restart `npm run dev`.

# Optional: real Vision AI for photos you upload yourself.
# Without it, uploads are filed as unverified and the three demo scenarios still work.
# WARNING: a VITE_ key is visible in the browser. Fine for a local demo; for a
# public deployment, call Gemini from a server or Supabase Edge Function instead.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
