# Copy to .env for local development, and set the same names in Vercel:
# Project settings > Environment Variables. Restart `npm run dev` after changes.
# The demo (#/demo) needs none of these. They switch on the live app's real services (#/live).

# Live photo check. Server-side only: read by api/verify-photo.js, never sent to the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the Gemini model for the check.
GEMINI_MODEL=gemini-2.5-flash

# Live shared reports between phones. Create a free Supabase project, run supabase/schema.sql
# in its SQL editor, then copy Project URL and the anon public key from Project settings > API.
# The anon key is public by design; row-level security in schema.sql limits what it can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Live rainfall needs no key (Open-Meteo).
